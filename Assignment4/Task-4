import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Number of Clicks: ");
        int n = sc.nextInt();

        int count = 0;

        for (int i = 1; i <= n; i++) {
            System.out.println("Dot Drawn at Click " + i);
            count++;
        }

        System.out.println("Total Clicks: " + count);
    }
}
